  <groupId>io.github.bmarwell</groupId>
  <artifactId>betterbranch</artifactId>
  <version>1.0.0-SNAPSHOT</version>

  <licenses>
    <license>
      <name>European Union Public Licence (EUPL) v1.2</name>
      <url>https://joinup.ec.europa.eu/collection/eupl/eupl-text-eupl-12</url>
      <distribution>repo</distribution>
      <comments>SPDX‑License‑Identifier: EUPL-1.2</comments>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>bmarwell</id>
      <name>Benjamin Marwell</name>
      <email>bmarwell@apache.org</email>
      <roles>
        <role>maintainer</role>
      </roles>
      <timezone>Europe/Berlin</timezone>
    </developer>
  </developers>

  <mailingLists>
    <mailingList>
      <name>GitHub Discussions</name>
      <archive>https://github.com/bmarwell/betterbranch/discussions</archive>
    </mailingList>
