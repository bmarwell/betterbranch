  <scm>
    <connection>scm:git:https://github.com/bmarwell/betterbranch.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/bmarwell/betterbranch.git</developerConnection>
    <tag>HEAD</tag>
    <url>https://github.com/bmarwell/betterbranch</url>
